# Copy this file to .env and fill in real values. Never commit the real .env file.

# Google Gemini API key used ONLY for operator-note interpretation.
GEMINI_API_KEY=

# Gemini model identifier (any current Gemini model that supports JSON response schemas).
GEMINI_MODEL=gemini-flash-lite-latest

# Port the service listens on.
PORT=8080

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Hard internal budget (seconds) for the whole /optimize-energy request before the
# service returns a controlled 500 instead of hanging past the judge's 30s timeout.
REQUEST_TIMEOUT_SECONDS=25

# Per-HTTP-call timeout (milliseconds) for each individual Gemini request. Kept well
# under REQUEST_TIMEOUT_SECONDS so one slow/overloaded call plus one retry still fits
# inside the overall budget.
LLM_CALL_TIMEOUT_MS=10000
